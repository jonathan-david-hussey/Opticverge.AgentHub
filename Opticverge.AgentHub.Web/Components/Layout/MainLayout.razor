@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu/>
    </div>

    <main>
        <div class="top-row">
            <div>
                <span class="breadcrumb">AgentHub / AI on Tap</span>
                <strong>Internal AI enablement hub</strong>
            </div>
            <div class="top-actions" aria-label="Hub status">
                <span class="status-dot"></span>
                <span>Local portfolio mode</span>
                <span>Policy gated</span>
            </div>
        </div>

        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">x</span>
</div>
