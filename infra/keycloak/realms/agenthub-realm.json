{
  "realm": "agenthub",
  "enabled": true,
  "roles": {
    "realm": [
      { "name": "admin" },
      { "name": "platform-engineer" },
      { "name": "viewer" }
    ]
  },
  "clients": [
    {
      "clientId": "agenthub-api",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false
    },
    {
      "clientId": "agenthub-web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "redirectUris": [ "https://localhost:*/signin-oidc", "http://localhost:*/signin-oidc" ],
      "webOrigins": [ "+" ]
    }
  ],
  "clientScopes": [
    {
      "name": "agenthub-roles",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "agenthub_role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "agenthub_role",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
